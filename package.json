{
  "name": "ipeitu",
  "version": "0.3.0",
  "private": true,
  "description": "WPS 标书本地配图库",
  "type": "module",
  "addonType": "wps",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test test/*.test.js",
    "test:ui": "node scripts/verify-ui.mjs",
    "check": "node scripts/check-syntax.mjs",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/remove.ps1",
    "service:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/service.ps1 -Action start",
    "service:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/service.ps1 -Action stop",
    "service:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/service.ps1 -Action status",
    "wps:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-wps.ps1",
    "wps:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-wps.ps1"
  },
  "dependencies": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
